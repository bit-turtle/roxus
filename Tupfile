# Source Paths
CCSOURCE =
CXXSOURCE =
include src/Tupfile

# Roxus Tupfile
CFLAGS += -ffreestanding -mno-red-zone -I include
CCFLAGS = $(CFLAGS) -std=c23
CXXFLAGS = $(CFLAGS) -std=c++23 -fno-exceptions -fno-rtti
LFLAGS = -subsystem:efi_application -entry:efi_main

# x86_64
ARCH := x86_64
NAME := x64
: foreach $(CCSOURCE) |> clang $(CCFLAGS) -target $(ARCH)-unknown-windows -c %f -o %o |> build/%B.$(ARCH).o
: foreach $(CXXSOURCE) |> clang $(CXXFLAGS) -target $(ARCH)-unknown-windows -c %f -o %o |> build/%B.$(ARCH).o
: build/*.$(ARCH).o |> lld -flavor link -out:build/boot$(NAME).efi %f $(LFLAGS) |> build/boot$(NAME).efi
: build/boot$(NAME).efi |> mkdir -p root/efi/boot && cp %f root/efi/boot |> root/efi/boot/boot$(NAME).efi

# aarch64
ARCH := aarch64
NAME := aa64
: foreach $(CCSOURCE) |> clang $(CCFLAGS) -target $(ARCH)-unknown-windows -c %f -o %o |> build/%B.$(ARCH).o
: foreach $(CXXSOURCE) |> clang $(CXXFLAGS) -target $(ARCH)-unknown-windows -c %f -o %o |> build/%B.$(ARCH).o
: build/*.$(ARCH).o |> lld -flavor link -out:build/boot$(NAME).efi %f $(LFLAGS) |> build/boot$(NAME).efi
: build/boot$(NAME).efi |> mkdir -p root/efi/boot && cp %f root/efi/boot |> root/efi/boot/boot$(NAME).efi
